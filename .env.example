# Base URL of the backend API.
# Use the host without a trailing slash because the code appends routes like /accounts/login/
API_URL=http://127.0.0.1:8000/api_jol

# Secret for signing the session cookie in src/lib/auth.ts
# Replace with a long random string in real environments.
SESSION_SECRET=change-me-to-a-long-random-secret

# Enable only behind ingress that overwrites X-Real-IP; block direct access to Next.
# Also configure TRUSTED_PROXY_IPS on Django (see backend RUNTIME.md).
TRUST_PROXY_CLIENT_IP=false
